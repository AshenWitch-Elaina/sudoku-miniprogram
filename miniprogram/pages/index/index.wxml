<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 背景层（毛玻璃效果） -->
  <view class="bg-blur"></view>
  
  <view class="content">
    <!-- 标题区域（无图片） -->
    <view class="title-area">
      <text class="main-title">数独</text>
      <text class="sub-title">Sudoku · 经典数字游戏</text>
    </view>

    <!-- 难度选择 -->
    <view class="difficulty-section">
      <text class="section-label">难度</text>
      <picker 
        class="difficulty-picker" 
        bindchange="onDifficultyChange" 
        value="{{difficultyIndex}}" 
        range="{{difficulties}}"
      >
        <view class="picker-display">
          <text class="difficulty-text">{{difficulties[difficultyIndex]}}</text>
          <text class="chevron">›</text>
        </view>
      </picker>
    </view>

    <!-- 主按钮区 -->
    <view class="action-buttons">
      <button class="btn-primary" bindtap="startGame" hover-class="btn-hover">
        <text>开始新游戏</text>
      </button>
      
      <view class="secondary-links">
        <text class="link" bindtap="goToProfile">个人中心</text>
        <text class="link-separator">·</text>
        <text class="link" bindtap="goToRank">排行榜</text>
      </view>
    </view>

    <view class="footer">
      <text>© 2026 数独 · 思维训练</text>
    </view>
  </view>
</view>