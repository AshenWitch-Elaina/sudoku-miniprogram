/* pages/index/index.wxss */
page {
  height: 100%;
  background-color: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Roboto, sans-serif;
}

.container {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 毛玻璃背景层 */
.bg-blur {
  position: absolute;
  top: -10%;
  left: -10%;
  width: 120%;
  height: 120%;
  background: linear-gradient(145deg, #f9f9fb 0%, #e8e8ed 100%);
  opacity: 0.8;
  filter: blur(60rpx);
  z-index: 0;
}

.content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 120rpx 40rpx 60rpx;
  flex: 1;
}

/* 标题区域 */
.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  margin-bottom: 120rpx;
}

.main-title {
  font-size: 96rpx;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: 4rpx;
  line-height: 1.1;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.sub-title {
  font-size: 32rpx;
  font-weight: 400;
  color: #86868b;
  letter-spacing: 1rpx;
}

/* 难度选择 */
.difficulty-section {
  width: 100%;
  max-width: 500rpx;
  margin-bottom: 80rpx;
  background-color: rgba(255,255,255,0.8);
  backdrop-filter: blur(20rpx); /* 毛玻璃效果，部分微信版本支持 */
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.02);
  border: 1rpx solid rgba(255,255,255,0.6);
}

.section-label {
  display: block;
  font-size: 28rpx;
  color: #6e6e73;
  margin-bottom: 8rpx;
  padding-left: 10rpx;
}

.difficulty-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 10rpx;
}

.difficulty-text {
  font-size: 40rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.chevron {
  font-size: 48rpx;
  color: #007aff;
  font-weight: 300;
  line-height: 1;
}

/* 按钮区域 */
.action-buttons {
  width: 100%;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-primary {
  width: 100%;
  background: #007aff;
  border: none;
  border-radius: 60rpx;
  padding: 28rpx 0;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 28rpx rgba(0,122,255,0.25);
  transition: all 0.2s ease;
}

.btn-primary text {
  color: white;
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
  box-shadow: 0 6rpx 14rpx rgba(0,122,255,0.2);
}

.secondary-links {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.link {
  font-size: 30rpx;
  color: #007aff;
  padding: 10rpx 20rpx;
  transition: opacity 0.2s;
}

.link:active {
  opacity: 0.6;
}

.link-separator {
  font-size: 30rpx;
  color: #c6c6c8;
}

/* 底部 */
.footer {
  margin-top: auto;
  padding: 40rpx 0 20rpx;
}

.footer text {
  font-size: 24rpx;
  color: #a1a1a6;
}