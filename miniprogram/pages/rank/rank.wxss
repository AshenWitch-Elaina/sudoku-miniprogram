/* pages/rank/rank.wxss */
page {
  background-color: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.container {
  padding: 4% 5% 8%;
  box-sizing: border-box;
  width: 100%;
}

/* 难度筛选卡片 */
.filter-card {
  width: 90%;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 4% 6%;
  margin-bottom: 6%;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.7);
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #1d1d1f;
}

.chevron {
  font-size: 28rpx;
  color: #86868b;
}

/* 排行榜卡片 */
.rank-card {
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 4% 0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.7);
}

/* 表头 */
.rank-header {
  display: flex;
  padding: 4% 6%;
  border-bottom: 2rpx solid #e9ecf3;
  font-weight: 600;
  color: #86868b;
  font-size: 26rpx;
}

/* 列表项 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 4% 6%;
  border-bottom: 1rpx solid #e9ecf3;
}

.rank-item:last-child {
  border-bottom: none;
}

/* 通用列样式 */
.rank-col {
  text-align: center;
  font-size: 32rpx;
}

.rank-col.rank {
  width: 15%;
  font-weight: 600;
  color: #1d1d1f;
}

.rank-col.user {
  width: 45%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
}

.rank-col.time {
  width: 20%;
  font-weight: 500;
  color: #007aff;
}

.rank-col.count {
  width: 20%;
  color: #1d1d1f;
}

/* 头像 */
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  margin-right: 3%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.nickname {
  font-size: 28rpx;
  color: #1d1d1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  color: #a1a1a6;
  font-size: 28rpx;
  padding: 10% 0;
}